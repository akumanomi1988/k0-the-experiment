{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-chaos.invalid/schemas/ruleset.v2.json",
  "title": "K0 ruleset design baseline v2.3 (legacy schema path)",
  "type": "object",
  "required": [
    "schemaVersion",
    "rulesetId",
    "status",
    "nations",
    "simulation",
    "citizens",
    "resources",
    "baseOutputMilliPerWorkerMinute",
    "production",
    "buildings",
    "progression",
    "governments",
    "strategic",
    "tournaments",
    "missions",
    "presentation",
    "operator",
    "season",
    "release",
    "privacy"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "2.4.0"
    },
    "rulesetId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "DESIGN_BASELINE_CANDIDATE_NOT_IMPLEMENTED"
    },
    "nations": {
      "type": "object",
      "required": [
        "count",
        "factionIds",
        "sameCompetitiveStart",
        "allowMixedProviders",
        "initialReleaseBroadcastMode",
        "firstExternalProvider",
        "multistreamerStartCondition",
        "unequalLiveSchedulesAllowed",
        "unequalLiveHoursCompensation"
      ],
      "properties": {
        "count": {
          "const": 3
        },
        "factionIds": {
          "const": [
            "micelios",
            "runicos",
            "ferrinos"
          ]
        },
        "sameCompetitiveStart": {
          "const": true
        },
        "allowMixedProviders": {
          "const": true
        },
        "initialReleaseBroadcastMode": {
          "const": "SINGLE_OPERATOR"
        },
        "firstExternalProvider": {
          "const": "youtube"
        },
        "multistreamerStartCondition": {
          "const": "three_authorized_bindings_no_simultaneous_live_required"
        },
        "unequalLiveSchedulesAllowed": {
          "const": true
        },
        "unequalLiveHoursCompensation": {
          "const": false
        }
      },
      "additionalProperties": true
    },
    "simulation": {
      "type": "object",
      "required": [
        "tickSeconds",
        "resourceScale",
        "offlineEconomyBp",
        "activityWindowSeconds",
        "rng",
        "economyFactorAppliedOnce",
        "competitionLiveClock"
      ],
      "properties": {
        "tickSeconds": {
          "const": 5
        },
        "resourceScale": {
          "const": 1000
        },
        "offlineEconomyBp": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "activityWindowSeconds": {
          "const": 7200
        },
        "rng": {
          "const": "sha256-counter-64-v1"
        },
        "economyFactorAppliedOnce": {
          "const": true
        },
        "competitionLiveClock": {
          "const": "global_three_nations_live_confirmed"
        }
      },
      "additionalProperties": true
    },
    "citizens": {
      "type": "object",
      "required": [
        "startingNpcPopulation",
        "initialNpcAllocation",
        "talentLevels",
        "activeHumanWorkersSoftCapScope",
        "humanQuotaAssignment",
        "humanWorkXpEligibility",
        "accountAllegiance",
        "chatIdentityFlow",
        "crossProviderUniqueness",
        "displayIdentityPolicy"
      ],
      "properties": {
        "startingNpcPopulation": {
          "type": "integer",
          "minimum": 1
        },
        "initialNpcAllocation": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "talentLevels": {
          "const": [
            3,
            7,
            12
          ]
        },
        "activeHumanWorkersSoftCapScope": {
          "const": "PER_NATION_TOTAL"
        },
        "humanQuotaAssignment": {
          "const": "deterministic_hash_rotation_nation_live_600s"
        },
        "humanWorkXpEligibility": {
          "const": "accepted_effective_work_only"
        },
        "accountAllegiance": {
          "const": "ONE_K0_ACCOUNT_ONE_NATION_PER_SEASON"
        },
        "chatIdentityFlow": {
          "const": "AUTO_PROVISION_K0_ACCOUNT_FROM_VERIFIED_PROVIDER_IDENTITY"
        },
        "crossProviderUniqueness": {
          "const": "REQUIRES_EXPLICIT_VERIFIED_ACCOUNT_LINK"
        },
        "displayIdentityPolicy": {
          "const": "GENERATED_PSEUDONYM_ALIAS_OPT_IN"
        }
      },
      "additionalProperties": true
    },
    "resources": {
      "type": "object",
      "required": [
        "ordinary",
        "gold",
        "stockInitial",
        "capacityInitial",
        "goldCreditOrigin"
      ],
      "additionalProperties": true
    },
    "baseOutputMilliPerWorkerMinute": {
      "type": "object",
      "required": [
        "food",
        "wood",
        "stone",
        "ore",
        "knowledge",
        "buildWork"
      ],
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "production": {
      "type": "object",
      "required": [
        "oreAvailableStartingEraIndex",
        "productionBonusStackCapBp"
      ],
      "additionalProperties": true
    },
    "buildings": {
      "type": "object",
      "required": [
        "maxConcurrentWorks",
        "mapInitialWidth",
        "mapInitialHeight"
      ],
      "additionalProperties": true
    },
    "progression": {
      "type": "object",
      "required": [
        "eras",
        "historyPointsPerEra",
        "milestonesPerEra",
        "pointsPerMilestone",
        "finalEraIndex",
        "seasonWinEvent",
        "finalEraGameplayEnabled",
        "eraMissionCatalog",
        "averageEraTargetDays",
        "targetSeasonWallDaysMin",
        "targetSeasonWallDaysMax"
      ],
      "properties": {
        "eras": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "historyPointsPerEra": {
          "const": 100
        },
        "milestonesPerEra": {
          "const": 5
        },
        "pointsPerMilestone": {
          "const": [
            20,
            20,
            20,
            20,
            20
          ]
        },
        "finalEraIndex": {
          "const": 13
        },
        "seasonWinEvent": {
          "const": "enter_final_era_committed"
        },
        "finalEraGameplayEnabled": {
          "const": false
        },
        "eraMissionCatalog": {
          "const": "era_missions.v2.3.json"
        },
        "averageEraTargetDays": {
          "const": 5.5
        },
        "targetSeasonWallDaysMin": {
          "const": 45
        },
        "targetSeasonWallDaysMax": {
          "const": 90
        }
      },
      "additionalProperties": true
    },
    "governments": {
      "type": "object",
      "required": [
        "electionLiveSeconds",
        "runoffLiveSeconds",
        "priorityVoteLiveSeconds"
      ],
      "properties": {
        "electionLiveSeconds": {
          "const": 3600
        },
        "runoffLiveSeconds": {
          "const": 180
        },
        "priorityVoteLiveSeconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "strategic": {
      "type": "object",
      "required": [
        "candidateCount",
        "voteLiveSeconds",
        "goldEffects",
        "oneCouncilPerNationPerPlayableEra"
      ],
      "properties": {
        "candidateCount": {
          "const": 3
        },
        "voteLiveSeconds": {
          "const": 600
        },
        "goldEffects": {
          "const": "cosmetic_prestige_only"
        },
        "oneCouncilPerNationPerPlayableEra": {
          "const": true
        }
      },
      "additionalProperties": true
    },
    "tournaments": {
      "type": "object",
      "required": [
        "kind",
        "territoryPenaltyActiveSeconds",
        "maxPausedTournamentWallHours",
        "pausedTournamentTimeoutPolicy"
      ],
      "properties": {
        "kind": {
          "const": "triangular_rps"
        },
        "territoryPenaltyActiveSeconds": {
          "const": 1800
        },
        "maxPausedTournamentWallHours": {
          "const": 72
        },
        "pausedTournamentTimeoutPolicy": {
          "const": "CANCEL_WITHOUT_PENALTY"
        }
      },
      "additionalProperties": true
    },
    "missions": {
      "type": "object",
      "required": [
        "timezone"
      ],
      "properties": {
        "timezone": {
          "const": "UTC"
        }
      },
      "additionalProperties": true
    },
    "presentation": {
      "type": "object",
      "required": [
        "artStyle",
        "tileWidthPx",
        "tileHeightPx",
        "pilotLocales",
        "pilotLayouts",
        "allPlayableEraArtRequiredBeforeFirstPilot",
        "requiredPlayableEraArtCount",
        "terminalEpilogueArtRequiredBeforeFirstPilot"
      ],
      "additionalProperties": true,
      "properties": {
        "pilotLocales": {
          "const": [
            "es-ES"
          ]
        },
        "pilotLayouts": {
          "const": [
            "VERTICAL_360_640",
            "HORIZONTAL_640_360"
          ]
        },
        "allPlayableEraArtRequiredBeforeFirstPilot": {
          "const": true
        },
        "requiredPlayableEraArtCount": {
          "const": 12
        },
        "terminalEpilogueArtRequiredBeforeFirstPilot": {
          "const": true
        }
      }
    },
    "operator": {
      "type": "object",
      "required": [
        "monetizationDefaultEnabled",
        "narrationMode",
        "narrationAuthority",
        "narrationFallback",
        "maxMonthlyInfrastructureBudgetEur"
      ],
      "properties": {
        "monetizationDefaultEnabled": {
          "const": false
        },
        "narrationMode": {
          "const": "GENERATIVE_LLM_REALTIME_DYNAMIC_TTS"
        },
        "narrationAuthority": {
          "const": "CONFIRMED_FACTS_ONLY_NO_GAME_MUTATIONS"
        },
        "narrationFallback": {
          "const": "APPROVED_TEMPLATES_AND_SUBTITLES"
        },
        "maxMonthlyInfrastructureBudgetEur": {
          "const": 100
        }
      },
      "additionalProperties": true
    },
    "season": {
      "type": "object",
      "required": [
        "keepAchievements",
        "keepStats",
        "keepHistory",
        "goldToPrestigeNoBonus",
        "startCondition",
        "streamerAbandonmentPolicy",
        "streamerAbandonmentCancelAfterDays",
        "showAccumulatedLiveHoursByNation",
        "streamerReturnPolicy",
        "streamerReturnDeadline",
        "streamerReturnPauseClockPolicy",
        "streamerReturnCancelledCompetitionPolicy",
        "streamerReturnMultipleIncidents"
      ],
      "additionalProperties": true,
      "properties": {
        "startCondition": {
          "const": "THREE_AUTHORIZED_CHANNELS_NOT_THREE_SIMULTANEOUS_LIVES"
        },
        "streamerAbandonmentPolicy": {
          "const": "CONFIRMED_EXIT_GLOBAL_PAUSE_ABORT_AFTER_7_WALL_DAYS"
        },
        "streamerAbandonmentCancelAfterDays": {
          "const": 7
        },
        "showAccumulatedLiveHoursByNation": {
          "const": true
        },
        "streamerReturnPolicy": {
          "const": "SAME_PRIMARY_REVERIFIED_OWNER_APPROVED_BEFORE_DEADLINE"
        },
        "streamerReturnDeadline": {
          "const": "STRICT_BEFORE_7_DAY_UTC_DEADLINE_ABORT_AT_EQUALITY"
        },
        "streamerReturnPauseClockPolicy": {
          "const": "NO_RETROACTIVE_ECONOMY_OR_LIVE_CATCHUP"
        },
        "streamerReturnCancelledCompetitionPolicy": {
          "const": "NEVER_REOPEN_CANCELLED"
        },
        "streamerReturnMultipleIncidents": {
          "const": "AUDIT_EACH_INCIDENT_ONE_ACTIVE_PER_SEASON"
        }
      }
    },
    "sourcePriority": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "release": {
      "type": "object",
      "required": [
        "firstDelivery",
        "firstLaunchMode",
        "firstRealPlatform",
        "requiresAuthorizedProviderEvidence",
        "publicLaunchMarket",
        "minorSafeguardsRequired",
        "monetizationGate",
        "ownShowFirst",
        "saasDeferred",
        "maxMonthlyInfraBudgetEur"
      ],
      "properties": {
        "firstDelivery": {
          "const": "TWELVE_PLAYABLE_ERAS_ENGINE_COMPLETE_BEFORE_PLATFORM_INTEGRATION"
        },
        "firstLaunchMode": {
          "const": "SINGLE_OPERATOR_THREE_CHANNELS"
        },
        "firstRealPlatform": {
          "const": "youtube"
        },
        "requiresAuthorizedProviderEvidence": {
          "const": true
        },
        "publicLaunchMarket": {
          "const": "ES_EU_GENERAL_AUDIENCE"
        },
        "minorSafeguardsRequired": {
          "const": true
        },
        "monetizationGate": {
          "const": "AFTER_GAME_VALIDATED_AND_PLATFORM_LEGAL_APPROVED"
        },
        "ownShowFirst": {
          "const": true
        },
        "saasDeferred": {
          "const": true
        },
        "maxMonthlyInfraBudgetEur": {
          "const": 100
        }
      },
      "additionalProperties": true
    },
    "privacy": {
      "type": "object",
      "required": [
        "operationalDataRetentionDays",
        "exceptions",
        "publicNamePolicy",
        "noRawCrossPlatformChat",
        "minorProtection"
      ],
      "properties": {
        "operationalDataRetentionDays": {
          "const": 30
        },
        "exceptions": {
          "const": "LEGAL_OBLIGATIONS_AND_ACCOUNTING_REQUIRING_LONGER_RETENTION"
        },
        "publicNamePolicy": {
          "const": "PSEUDONYM_BY_DEFAULT_ALIAS_ONLY_WITH_CONSENT"
        },
        "noRawCrossPlatformChat": {
          "const": true
        },
        "minorProtection": {
          "const": "EU_GENERAL_AUDIENCE_MINIMIZATION_NO_TARGETED_MONETIZATION"
        }
      },
      "additionalProperties": true
    }
  }
}
