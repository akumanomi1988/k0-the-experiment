{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-chaos.invalid/schemas/nation_delta.v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "seasonId",
    "nationId",
    "sequence",
    "serverUtc",
    "stateHash",
    "eraIndex",
    "historicalPoints",
    "liveState",
    "resources",
    "buildingChanges",
    "activeCitizenCount"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "seasonId": {
      "type": "string",
      "minLength": 1
    },
    "nationId": {
      "enum": [
        "micelios",
        "runicos",
        "ferrinos"
      ],
      "description": "Public NationPublicId: faction slug. SQL nations.nation_id is UUID, resolved by (season_id, faction_id)."
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "serverUtc": {
      "type": "string",
      "format": "date-time"
    },
    "stateHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "eraIndex": {
      "type": "integer",
      "minimum": 1,
      "maximum": 13
    },
    "historicalPoints": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "liveState": {
      "enum": [
        "LIVE_CONFIRMED",
        "OFFLINE_CONFIRMED",
        "UNCERTAIN"
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "buildingChanges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "buildingId",
          "state"
        ],
        "properties": {
          "buildingId": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "QUEUED",
              "BUILDING",
              "COMPLETED",
              "CANCELLED"
            ]
          },
          "completionBp": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        }
      }
    },
    "activeCitizenCount": {
      "type": "integer",
      "minimum": 0
    },
    "eventCue": {
      "type": "string"
    }
  }
}
